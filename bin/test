#!/usr/bin/env python3
"""Runs the test suite: python bin/test [pytest arguments, e.g. -v or -k pattern]"""
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.exit(subprocess.call([sys.executable, "-m", "pytest", "-p", "no:cacheprovider", *sys.argv[1:]], cwd=ROOT))
